{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PERTURABO CLIPPING — Premium Bus (cerveau partagé)",
  "description": "Schema PUBLIC (commite) du bus premium/oracle du CLIPPING. Il documente comment les frégates (F00B arbitrage, F00C tri sémantique, F04 copywriter) atteignent le cerveau partagé SHARED/brain.py. Aucune clé n'y figure jamais : seuls des NOMS de variables d'environnement. Le mode oracle est un relais fichier sans réseau (voir oracle_relay_schema.json).",
  "type": "object",
  "required": ["mode_resolution", "premium", "oracle"],
  "properties": {
    "mode_resolution": {
      "type": "array",
      "description": "Ordre de préférence appliqué par brain.available_mode(). Le premier mode prêt gagne.",
      "items": { "enum": ["premium", "oracle", "off"] },
      "default": ["premium", "oracle", "off"]
    },
    "premium": {
      "type": "object",
      "description": "Clé directe d'un provider (NVIDIA NIM / CLIPPING_*). Voie rapide quand la clé est valide. En cas d'absence ou de refus (401/402/403/429/5xx/réseau), brain bascule sur le relais oracle.",
      "required": ["env_var_name"],
      "properties": {
        "env_var_name": {
          "type": "string",
          "description": "Variable lue en priorité. brain.py essaie NVIDIA_NIM_API_KEY → CLIPPING_F00B_API_KEY → CLIPPING_PREMIUM_API_KEY.",
          "examples": ["NVIDIA_NIM_API_KEY", "CLIPPING_F00B_API_KEY", "CLIPPING_PREMIUM_API_KEY"]
        },
        "base_url_env_var": { "type": "string", "default": "NVIDIA_NIM_BASE_URL" },
        "base_url_default": { "type": "string", "default": "https://integrate.api.nvidia.com/v1" },
        "model_env_var": { "type": "string", "default": "NVIDIA_NIM_MODEL" },
        "model_default": { "type": "string", "default": "openai/gpt-oss-20b" }
      }
    },
    "oracle": {
      "type": "object",
      "description": "Relais fichier sans clé : question écrite dans ORACLE/pending/, réponse lue dans ORACLE/answers.json. Aucun appel réseau, aucune clé. Voir CONTRACTS/oracle_relay_schema.json.",
      "required": ["type", "pending_dir", "answers_file"],
      "properties": {
        "type": { "const": "file-relay" },
        "enabled_env_var": { "type": "string", "default": "ORACLE_RELAY_ENABLED" },
        "dir_env_var": { "type": "string", "default": "ORACLE_RELAY_DIR" },
        "strict_env_var": { "type": "string", "default": "ORACLE_RELAY_STRICT" },
        "pending_dir": { "type": "string", "default": "MONDES_FORGES/CLIPPING/ORACLE/pending" },
        "answers_file": { "type": "string", "default": "MONDES_FORGES/CLIPPING/ORACLE/answers.json" },
        "model_default": { "type": "string", "default": "sandbox-agent" },
        "provider_label": { "type": "string", "default": "ORACLE_RELAY" },
        "pending_status": { "type": "string", "default": "pending" },
        "strict_effect": { "type": "string", "default": "pending->error" }
      }
    },
    "safety": {
      "type": "object",
      "description": "Doctrine de sécurité non négociable du bus.",
      "properties": {
        "keys_in_files": { "const": false },
        "keys_logged": { "const": false },
        "keys_returned_in_manifests": { "const": false },
        "oracle_network_calls": { "const": false },
        "oracle_requires_key": { "const": false },
        "dependency": { "const": "stdlib-only" },
        "off_is_fatal": { "const": false }
      }
    }
  },
  "examples": [
    {
      "mode_resolution": ["premium", "oracle", "off"],
      "premium": { "env_var_name": "NVIDIA_NIM_API_KEY" },
      "oracle": {
        "type": "file-relay",
        "pending_dir": "MONDES_FORGES/CLIPPING/ORACLE/pending",
        "answers_file": "MONDES_FORGES/CLIPPING/ORACLE/answers.json"
      },
      "safety": {
        "keys_in_files": false,
        "keys_logged": false,
        "keys_returned_in_manifests": false,
        "oracle_network_calls": false,
        "oracle_requires_key": false,
        "dependency": "stdlib-only",
        "off_is_fatal": false
      }
    }
  ]
}

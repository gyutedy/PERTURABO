{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schema_analysis — sortie F02 BREACHER",
  "type": "object",
  "required": ["generated_at", "ligue", "analyses"],
  "properties": {
    "generated_at": {"type": "string"},
    "ligue": {"type": "string"},
    "ligue_moyennes": {
      "type": "object",
      "properties": {
        "buts_dom_moy": {"type": "number"},
        "buts_ext_moy": {"type": "number"},
        "part_mt1_ligue": {"type": "number", "description": "≈0.42-0.44 par défaut, mesuré si data"},
        "rho": {"type": "number", "description": "Dixon-Coles. Fit ligue ou defaut -0.13"},
        "bonus_domicile": {"type": "number"},
        "bonus_exterieur": {"type": "number"},
        "baseline": {"type": "string", "description": "saison | carte"},
        "params": {"type": "string", "description": "fitted | default"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "holes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "probas", "lambdas", "data_quality"],
        "properties": {
          "id": {"type": "string"},
          "match": {"type": "string"},
          "lambdas": {
            "type": "object",
            "properties": {
              "dom_total": {"type": "number"}, "ext_total": {"type": "number"},
              "dom_mt1": {"type": "number"}, "dom_mt2": {"type": "number"},
              "ext_mt1": {"type": "number"}, "ext_mt2": {"type": "number"},
              "dom_raw": {"type": "number", "description": "S13 lambda avant facteurs etat"},
              "ext_raw": {"type": "number"}
            }
          },
          "probas": {
            "type": "object",
            "properties": {
              "1": {"type": "number"}, "X": {"type": "number"}, "2": {"type": "number"},
              "o2.5": {"type": "number"}, "u2.5": {"type": "number"},
              "btts": {"type": "number"},
              "mt1_plus": {"type": "number", "description": "P(MT1 > MT2)"},
              "mte": {"type": "number", "description": "P(MT1 = MT2) — inclut 0-0/0-0, tue le pari MT2"},
              "mt2_plus": {"type": "number", "description": "P(MT2 > MT1) ≠ part des buts en MT2"},
              "o0.5": {"type": "number"}, "u0.5": {"type": "number"},
              "o1.5": {"type": "number"}, "u1.5": {"type": "number"},
              "o3.5": {"type": "number"}, "u3.5": {"type": "number"},
              "o4.5": {"type": "number"}, "u4.5": {"type": "number"},
              "dc_1x": {"type": "number"}, "dc_x2": {"type": "number"}, "dc_12": {"type": "number"},
              "btts_no": {"type": "number"},
              "score_le_plus_probable": {"type": "string"}
            }
          },
          "cs": {
            "type": "object",
            "description": "Top N scores exacts (+ cles cotees). Meme matrice, zero equation changee."
          },
          "holes": {"type": "array", "items": {"type": "string"},
            "description": "S13 holes effectifs. PAS dans data_quality (A3 intact)."},
          "state_factors": {
            "type": "object",
            "description": "S13 table A + flags S15 (injuries API). Vide = applied false, factor 1.00, holes. S15 n ajuste jamais factor_*.",
            "properties": {
              "applied": {"type": "boolean"},
              "factor_dom": {"type": "number"},
              "factor_ext": {"type": "number"},
              "flags": {"type": "array", "items": {"type": "string"},
                "description": "S13 rotation_lourde/derby/meteo/retour_100/cap_hit + S15 buteur_manquant/defenseur_manquant/double_motivation/satisfait_nul"},
              "holes": {"type": "array", "items": {"type": "string"}},
              "cap_hit": {"type": "boolean"},
              "journal": {"type": "array", "items": {"type": "string"}}
            }
          },
          "data_quality": {
            "type": "object",
            "properties": {
              "niveau": {"type": "string", "enum": ["haute", "moyenne", "basse"]},
              "flags": {"type": "array", "items": {"type": "string"},
                "description": "ex: mt_splits_estimates, mj_insuffisant. Pas de hole effectifs ici."}
            }
          }
        }
      }
    }
  }
}
